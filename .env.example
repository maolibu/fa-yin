# CBETA 经文数据路径（用户自行下载 CBReader 后填入）
CBETA_BASE=/path/to/cbeta

# 组字数据路径（通常不需要修改）
# GAIJI_PATH=/path/to/cbeta_gaiji.json

# 数据库与用户数据（迁移/测试时必须指向隔离目录）
# DB_DIR=/path/to/data/db
# CBETA_SEARCH_DB=/path/to/data/db/cbeta_search.db
# DICTS_DB=/path/to/data/db/dicts.db
# LINEAGE_DB=/path/to/data/db/lineage.db
# USER_DATA_DIR=/path/to/data/user_data
# USER_DICT_DIR=/path/to/data/dicts/user

# Obsidian Vault 与 ETL 日志输出
# OBSIDIAN_VAULT_DIR=/path/to/obsidian-vault
# ETL_LOG_DIR=/path/to/logs/etl

# 笔记导出到 Obsidian（可选）
# OBSIDIAN_INBOX_PATH=/path/to/obsidian/inbox

# AI 释义（可选，用户也可在阅读器设置面板填入 API Key）
# AI_API_KEY=sk-xxx
# AI_DEFAULT_PROVIDER=deepseek
